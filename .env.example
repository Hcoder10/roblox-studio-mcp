# Cloud MCP Server
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Roblox Open Cloud API (for cloud_api tools)
ROBLOX_CLOUD_API_KEY=your_api_key_here

# Agent Harness
AGENT_PORT=3001
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
MCP_SERVER_URL=https://roblox-studio-mcp.up.railway.app

# Optional: Alternative model providers
# OPENAI_API_KEY=your_openai_key
# ANTHROPIC_API_KEY=your_anthropic_key
